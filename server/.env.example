# Where your music lives on this PC (the server only ever READS this folder)
MUSIC_DIR=C:\Music

# Login the phone app will use
ADMIN_USER=admin
ADMIN_PASSWORD=changeme

# Optional: token lifetime in days (default 90)
# TOKEN_TTL_DAYS=90

# Optional: scan the folder automatically when the server starts (default true)
# SCAN_ON_START=1

# Optional: brute-force throttle for /api/login
# LOGIN_MAX_ATTEMPTS=8
# LOGIN_WINDOW_SECONDS=60

# Optional: where the database + extracted covers are stored
# DATA_DIR=C:\Music\music-lab-data

# Optional: absolute path to a Flutter web build to serve from this same port
# WEB_DIR=C:\path\to\music-lab\app\build\web
